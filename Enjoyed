// Simple server setup (Node.js + Express)
const express = require('express');
const app = express();
const PORT = 3000;

app.use(express.static('public'));
app.use(express.json());

// Sample levels
the levels = [
    { id: 1, question: "Write a function that returns 'Hello, World!'.", test: "return helloWorld() === 'Hello, World!';" },
    { id: 2, question: "Write a function that squares a number.", test: "return square(4) === 16;" }
];

app.get('/levels', (req, res) => {
    res.json(levels);
});

app.post('/submit', (req, res) => {
    const { code, levelId } = req.body;
    const level = levels.find(l => l.id === levelId);
    
    if (!level) return res.status(400).json({ error: "Invalid level." });
    
    try {
        const userFunction = new Function(`${code}; ${level.test}`);
        const result = userFunction();
        res.json({ success: result });
    } catch (error) {
        res.json({ success: false, error: error.message });
    }
});

app.listen(PORT, () => console.log(`Server running on http://localhost:${PORT}`));
